<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A3A3A"
                android:endColor="#0F2020"
                android:angle="135" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2A4E4E" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
