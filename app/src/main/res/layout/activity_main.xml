<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SiempreCerca"
                    android:textSize="26sp"
                    android:textColor="@color/primary_light"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitor BLE"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Theme toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnThemeLight"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="☀"
                    android:textSize="16sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_muted"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnThemeDark"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:text="☾"
                    android:textSize="16sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status Card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/indicator_red"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIANDO..."
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
        </LinearLayout>

        <!-- Info Card -->
        <LinearLayout
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispositivo"
                android:textSize="12sp"
                android:textColor="@color/primary_light"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reloj: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_border"
                android:layout_marginVertical="8dp" />

            <TextView
                android:id="@+id/tvFlicBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bateria FLIC: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPhoneBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bateria celular: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Alerts Card -->
        <LinearLayout
            android:id="@+id/cardAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAlertsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textSize="12sp"
                android:textColor="@color/primary_light"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLastAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultima alerta: Ninguna"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvLastClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultimo click: --"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvAlertCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total alertas: 0"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvPendingAlerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas pendientes: 0"
                android:textSize="15sp"
                android:textColor="@color/warning"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Health Check Card -->
        <LinearLayout
            android:id="@+id/cardHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvHealthTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Health Check"
                    android:textSize="12sp"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <Switch
                    android:id="@+id/switchHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/primary_light"
                    android:trackTint="@color/btn_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHealthDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ping cada 1h al servidor para detectar inactividad."
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health check activado"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Contacts Card -->
        <LinearLayout
            android:id="@+id/cardContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvContactsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contactos SMS"
                android:textSize="12sp"
                android:textColor="@color/primary_light"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contactos SMS: --"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Buttons Grid 2x2 -->
        <LinearLayout
            android:id="@+id/gridButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <!-- Row 1: Reconectar + Test SOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnReconnect"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Reconectar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnTestSos"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Test SOS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_warning"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="5dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Row 2: Actualizar + Reconfigurar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Actualizar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_success"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="5dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="Reconfigurar"
                    android:textSize="14sp"
                    android:background="@drawable/btn_muted"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="5dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Version -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v3.0.0"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
