<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo / Titulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SiempreCerca"
            android:textSize="28sp"
            android:textColor="#E94560"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitor BLE"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/indicator_red"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIANDO..."
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reloj: --"
                android:textSize="16sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente: --"
                android:textSize="16sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth: --"
                android:textSize="16sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>

        <!-- Alerts Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:textSize="18sp"
                android:textColor="#E94560"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLastAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultima alerta: Ninguna"
                android:textSize="15sp"
                android:textColor="#CCCCCC"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAlertCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total alertas: 0"
                android:textSize="15sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>

        <!-- Health Check Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Health Check"
                    android:textSize="18sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switchHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#4CAF50"
                    android:trackTint="#333355" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Envia un ping cada 1 hora al servidor. Si no llega, se genera una alerta."
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvHealthStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health check activado"
                android:textSize="15sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>

        <!-- Contacts Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contactos SMS: --"
                android:textSize="15sp"
                android:textColor="#CCCCCC" />
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnReconnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reconectar"
            android:textSize="16sp"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reconfigurar"
            android:textSize="16sp"
            android:backgroundTint="#333355"
            android:textColor="#999999" />

        <!-- Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
