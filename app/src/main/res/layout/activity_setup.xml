<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setupScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/ivSetupLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/ic_launcher_foreground"
                android:scaleType="centerCrop"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SiempreCerca"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSetupSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configurar monitor"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Theme toggle pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:padding="3dp">

                <Button
                    android:id="@+id/btnSetupThemeLight"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:text="☀"
                    android:textSize="14sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/text_muted"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btnSetupThemeDark"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:text="☾"
                    android:textSize="14sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Server status -->
        <TextView
            android:id="@+id/tvServerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conectando..."
            android:textSize="13sp"
            android:textColor="@color/warning"
            android:paddingHorizontal="4dp"
            android:layout_marginBottom="28dp" />

        <!-- PASO 1 Card -->
        <LinearLayout
            android:id="@+id/cardStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_light"
                    android:gravity="center"
                    android:background="@drawable/metric_card"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvStep1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PACIENTE"
                    android:textSize="12sp"
                    android:textColor="@color/primary_light"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etClientId"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="Ej: 10"
                    android:inputType="number"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:background="@drawable/input_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnBuscarPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Buscar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:textColor="#CCEEEE"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/green"
                android:visibility="gone"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- PASO 2 Card -->
        <LinearLayout
            android:id="@+id/cardStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="2"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_light"
                    android:gravity="center"
                    android:background="@drawable/metric_card"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvStep2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VINCULAR FLIC"
                    android:textSize="12sp"
                    android:textColor="@color/primary_light"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvScanDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca el boton y luego presiona tu FLIC. Acepta la vinculacion cuando aparezca."
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="16dp" />

            <!-- Boton circular con logo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnScan"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher_foreground"
                    android:scaleType="centerCrop"
                    android:background="@drawable/btn_scan_circle"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Buscar y vincular FLIC" />

                <TextView
                    android:id="@+id/tvScanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:text="Toca para buscar"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="-4dp" />
            </FrameLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary_light"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvScanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSelectedDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/green"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Boton Activar -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Activar monitoreo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_accent"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
